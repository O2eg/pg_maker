@@ -199,6 +199,18 @@
 
 UPDATE part_config SET premake = 5 WHERE parent_table = 'partman_test.time_taptest_table';
 
+-- PostgreSQL 11+ inherits foreign keys from the partitioned parent, not
+-- the pg_partman template. Preserve the initial no-FK checks above, then
+-- install the parent constraint before checking inheritance by new children.
+DO $parent_fk$
+BEGIN
+    IF current_setting('server_version_num')::int >= 110000 THEN
+        ALTER TABLE partman_test.time_taptest_table
+            ADD FOREIGN KEY (col2) REFERENCES partman_test.fk_test_reference(col2);
+    END IF;
+END
+$parent_fk$;
+
 -- Run to create proper future partitions
 SELECT run_maintenance();
 -- Insert after maintenance since native fails with no child

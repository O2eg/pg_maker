@@ -926,7 +926,12 @@
 	rel = table_open(reloid, AccessShareLock);
 
 	nspname = get_namespace_name(RelationGetNamespace(rel));
-	relname = RelationGetRelationName(rel);
+	/*
+	 * Keep our own name: truncate_table waits for AccessExclusiveLock after

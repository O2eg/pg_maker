+#if PG_VERSION_NUM >= 170000 && PG_VERSION_NUM < 180000
+/*
+ * PG17 does not assign IDs to analyzed queries inside utility statements.
+ * Jumble these during parse analysis, before the utility hook deliberately
+ * clears IDs for execution.  Do not re-enable IDs at planner entry: that would
+ * also track rewritten materialized-view queries that core leaves untracked.
+ */
+static void
+pgqp_jumble_utility_query(Query *query)
+{
+	Node *utility = query->utilityStmt;
+	Node *child = NULL;
+	Query *nested;
+
+	check_stack_depth();
+	if (utility == NULL)
+		return;
+	if (IsA(utility, DeclareCursorStmt))
+		child = ((DeclareCursorStmt *) utility)->query;
+	else if (IsA(utility, ExplainStmt))
+		child = ((ExplainStmt *) utility)->query;
+	else if (IsA(utility, CreateTableAsStmt) &&
+			 ((CreateTableAsStmt *) utility)->objtype != OBJECT_MATVIEW)
+		child = ((CreateTableAsStmt *) utility)->query;
+	if (child == NULL || !IsA(child, Query))
+		return;
+	nested = (Query *) child;
+	if (nested->commandType == CMD_UTILITY)
+		pgqp_jumble_utility_query(nested);
+	else if (nested->queryId == invalid_id)
+		JumbleQuery(nested);
+}
+#endif
+

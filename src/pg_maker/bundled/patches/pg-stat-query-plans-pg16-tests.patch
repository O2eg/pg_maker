+/* PG16 client adapter for the upstream named/unnamed protocol scenario. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <libpq-fe.h>
+
+static void
+require_result(PGconn *conn, PGresult *res, ExecStatusType status)
+{
+    if (!res || PQresultStatus(res) != status)
+    {
+        fprintf(stderr, "protocol test failed: %s\n", PQerrorMessage(conn));
+        PQclear(res);
+        PQfinish(conn);
+        exit(1);
+    }
+}
+
+static void
+execute(PGconn *conn, const char *name, int count, const char **values)
+{
+    PGresult *res = name
+        ? PQexecPrepared(conn, name, count, values, NULL, NULL, 0)
+        : PQexecParams(conn, "SELECT $1 ", count, NULL, values, NULL, NULL, 0);
+    int i;
+    require_result(conn, res, PGRES_TUPLES_OK);
+    if (PQntuples(res) != 1 || PQnfields(res) != count)
+    {
+        fprintf(stderr, "unexpected protocol result shape\n");
+        exit(1);
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (PQgetisnull(res, 0, i) || strcmp(PQgetvalue(res, 0, i), values[i]))
+        {
+            fprintf(stderr, "protocol result value differs\n");
+            exit(1);
+        }
+    }
+    PQclear(res);
+}
+
+int
+main(void)
+{
+    PGconn *conn = PQconnectdb("");
+    PGresult *res;
+    const char *names[] = {"stmt1", "stmt2", "stmt3"};
+    const char *queries[] = {"SELECT $1 ", "SELECT $1, $2 ", "SELECT $1, $2, $3 "};
+    const char *v0[] = {"unnamed_val1"};
+    const char *v1[] = {"stmt1_val1"};
+    const char *v2[] = {"stmt2_val1", "stmt2_val2"};
+    const char *v3[] = {"stmt3_val1", "stmt3_val2", "stmt3_val3"};
+    const char *v4[] = {"stmt3_val4", "stmt3_val5", "stmt3_val6"};
+    const char *v5[] = {"stmt2_val3", "stmt2_val4"};
+    int i;
+    if (PQstatus(conn) != CONNECTION_OK)
+    {
+        fprintf(stderr, "connection failed: %s\n", PQerrorMessage(conn));
+        return 1;
+    }
+    res = PQexec(conn, "SET pg_stat_query_plans.track_utility = FALSE");
+    require_result(conn, res, PGRES_COMMAND_OK);
+    PQclear(res);
+    for (i = 0; i < 3; i++)
+    {
+        res = PQprepare(conn, names[i], queries[i], i + 1, NULL);
+        require_result(conn, res, PGRES_COMMAND_OK);
+        PQclear(res);
+    }
+    execute(conn, NULL, 1, v0);
+    execute(conn, names[0], 1, v1);
+    execute(conn, names[1], 2, v2);
+    execute(conn, names[2], 3, v3);
+    execute(conn, names[2], 3, v4);
+    execute(conn, names[1], 2, v5);
+    execute(conn, names[0], 1, v1);
+    PQfinish(conn);
+    puts("named and unnamed extended protocol: 7 results verified");
+    return 0;
+}

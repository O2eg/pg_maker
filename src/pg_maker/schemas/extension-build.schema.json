{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pg_maker:schema:extension-build:v1",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "pg_maker/extension-build/v1"
    },
    "kind": {
      "const": "ExtensionBuild"
    },
    "spec": {
      "type": "object",
      "properties": {
        "target": {
          "type": "object",
          "properties": {
            "provider": {
              "enum": [
                "community",
                "profile",
                "custom"
              ]
            },
            "major": {
              "type": "integer",
              "minimum": 14,
              "maximum": 99
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000\\r\\n]+$"
            },
            "profile": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000\\r\\n]+$"
            },
            "os": {
              "type": "object",
              "properties": {
                "id": {
                  "enum": [
                    "debian",
                    "rocky"
                  ]
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\u0000\\r\\n]+$"
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            },
            "architecture": {
              "enum": [
                "amd64",
                "arm64"
              ]
            },
            "format": {
              "enum": [
                "deb",
                "rpm"
              ]
            },
            "base_image": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000\\r\\n]+$"
            },
            "pg_config": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000\\r\\n]+$"
            },
            "server_package": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000\\r\\n]+$"
            },
            "sdk_packages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              }
            },
            "runtime_packages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              }
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\\u0000\\r\\n]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "pgdg": {
              "type": "boolean"
            },
            "dependency_policy": {
              "enum": [
                "exact",
                "major"
              ]
            },
            "split_bundled": {
              "type": "boolean"
            }
          },
          "required": [
            "provider",
            "major",
            "os",
            "architecture",
            "format",
            "base_image",
            "pg_config",
            "server_package",
            "sdk_packages",
            "runtime_packages",
            "packages",
            "pgdg",
            "dependency_policy"
          ],
          "additionalProperties": false
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "recipe": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "package_revision": {
                "type": "integer",
                "minimum": 1
              },
              "package_name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "license": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              }
            },
            "required": [
              "recipe",
              "version",
              "package_revision",
              "license"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "execution": {
          "type": "object",
          "properties": {
            "jobs": {
              "type": "integer",
              "minimum": 1
            },
            "memory_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "min_free_disk_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "stage_timeout_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "keep_workspace": {
              "enum": [
                "always",
                "on-failure"
              ]
            }
          },
          "required": [
            "jobs",
            "memory_bytes",
            "min_free_disk_bytes",
            "stage_timeout_seconds",
            "keep_workspace"
          ],
          "additionalProperties": false
        },
        "validation": {
          "type": "object",
          "properties": {
            "run_tests": {
              "type": "boolean"
            }
          },
          "required": [
            "run_tests"
          ],
          "additionalProperties": false
        },
        "maintainer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$"
        }
      },
      "required": [
        "target",
        "extensions",
        "execution",
        "validation",
        "maintainer"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "api_version",
    "kind",
    "spec"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pg-maker.dev/schemas/publication.schema.json",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "pg_maker/publication/v1"
    },
    "kind": {
      "const": "PublicationConfig"
    },
    "spec": {
      "type": "object",
      "properties": {
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "adapter": {
                "enum": [
                  "nexus-apt",
                  "nexus-yum",
                  "nexus-raw",
                  "directory"
                ]
              },
              "formats": {
                "type": "array",
                "items": {
                  "enum": [
                    "deb",
                    "rpm"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "repository": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "directory": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "path_prefix": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "auth": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "username_env": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[^\\u0000\\r\\n]+$"
                      },
                      "password_env": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[^\\u0000\\r\\n]+$"
                      }
                    },
                    "required": [
                      "username_env",
                      "password_env"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "netrc_file": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[^\\u0000\\r\\n]+$"
                      }
                    },
                    "required": [
                      "netrc_file"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "bearer_env": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[^\\u0000\\r\\n]+$"
                      }
                    },
                    "required": [
                      "bearer_env"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "tls": {
                "type": "object",
                "properties": {
                  "verify": {
                    "type": "boolean"
                  },
                  "ca_file": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\\u0000\\r\\n]+$"
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "allow_http": {
                "type": "boolean"
              },
              "suite": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "component": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              }
            },
            "required": [
              "id",
              "adapter",
              "formats"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "request_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "verification_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "poll_interval_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "source_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "repositories"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "api_version",
    "kind",
    "spec"
  ],
  "additionalProperties": false
}

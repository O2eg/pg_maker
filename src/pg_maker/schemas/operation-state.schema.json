{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pg_maker:schema:operation-state:v1",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "pg_maker/operation/v1"
    },
    "kind": {
      "const": "OperationState"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "operation_kind": {
      "enum": [
        "container_commands",
        "prepare_environments",
        "resolve_inputs",
        "build",
        "runtime_image",
        "development_command"
      ]
    },
    "input_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "interrupted",
        "partial"
      ]
    },
    "owner": {
      "type": [
        "object",
        "null"
      ]
    },
    "owner_token": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "progress": {
      "type": "object",
      "properties": {
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "completed",
        "total"
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "api_version",
    "kind",
    "operation_id",
    "operation_kind",
    "input_hash",
    "request_id",
    "status",
    "owner",
    "owner_token",
    "attempt",
    "sequence",
    "created_at",
    "updated_at",
    "progress",
    "resources",
    "result",
    "error"
  ],
  "additionalProperties": false
}
